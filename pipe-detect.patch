@@ -180,6 +189,12 @@ void lsx_clearerr(sox_format_t * ft)
 
 int lsx_unreadb(sox_format_t * ft, unsigned b)
 {
+  /* While pending bytes remain, the last byte read came from them */
+  if (ft->pending_count) {
+    *--ft->pending_bytes = (char)b;
+    ft->pending_count++;
+    return (int)b;
+  }
   return ungetc((int)b, ft->fp);
 }
 
