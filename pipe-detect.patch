diff --git a/src/formats_i.c b/src/formats_i.c
index 7048040..c9d7304 100644
--- a/src/formats_i.c
+++ b/src/formats_i.c
@@ -95,9 +95,18 @@ int lsx_check_read_params(sox_format_t * ft, unsigned channels,
  */
 size_t lsx_readbuf(sox_format_t * ft, void *buf, size_t len)
 {
-  size_t ret = fread(buf, (size_t) 1, len, (FILE*)ft->fp);
-  if (ret != len && ferror((FILE*)ft->fp))
-    lsx_fail_errno(ft, errno, "lsx_readbuf");
+  size_t ret = 0;
+  if (ft->pending_count) {
+    ret = min(len, ft->pending_count);
+    memcpy(buf, ft->pending_bytes, ret);
+    ft->pending_bytes += ret;
+    ft->pending_count -= ret;
+  }
+  if (ret < len) {
+    ret += fread((char *)buf + ret, (size_t) 1, len - ret, (FILE*)ft->fp);
+    if (ret != len && ferror((FILE*)ft->fp))
+      lsx_fail_errno(ft, errno, "lsx_readbuf");
+  }
   ft->tell_off += ret;
   return ret;
 }
@@ -158,7 +167,7 @@ off_t lsx_tell(sox_format_t * ft)
 
 int lsx_eof(sox_format_t * ft)
 {
-  return feof((FILE*)ft->fp);
+  return ft->pending_count ? 0 : feof((FILE*)ft->fp);
 }
 
